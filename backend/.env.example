# --- Gemini AI Configuration ---
# Your primary Gemini API Key (Required for Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: For backwards compatibility or secondary uses
GEMINI_API_KEY_CHATBOT=your_gemini_api_key_here

# The Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Batch Processing AI Keys (Optional) ---
# Used for data cleaning/mood extraction scripts (fetchMood.py)
GEMINI_API_KEY_1=your_key_1
GEMINI_API_KEY_2=your_key_2
GEMINI_API_KEY_3=your_key_3
GEMINI_API_KEY_4=your_key_4
GEMINI_API_KEY_5=your_key_5

# --- Database Configuration ---
# MongoDB Connection URI (e.g. mongodb://localhost:27017/)
MONGO_URI=mongodb://localhost:27017/

# Your MongoDB Database name (e.g. WatchWise)
DATABASE_NAME=WatchWise
